  id          String   @id @default(uuid()) @db.Char(36)
  title       String   @db.VarChar(255)
  category    String   @default("annual_report") @db.VarChar(100) // annual_report, financial_statement, bylaw, brochure, policy
  description String?  @db.Text
  fileUrl     String   @db.VarChar(500)
  fileSize    String?  @db.VarChar(50)
  year        Int?
  downloads   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(3)

  @@index([isActive, category])
  @@map("website_publications")
}

model WebsiteSetting {
  id        String   @id @default(uuid()) @db.Char(36)
  key       String   @unique @db.VarChar(100)
  value     String   @db.Text
  group     String   @default("general") @db.VarChar(50) // general, contact, social, statistics, rates
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(3)

  @@index([group])
  @@map("website_settings")
}



