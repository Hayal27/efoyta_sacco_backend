  leaveApplications     HrLeaveApplication[]
  attendanceRecords     HrAttendanceRecord[]
  appraisals            HrPerformanceAppraisal[]
  movements             HrEmployeeMovement[]
  trainingParticipants  HrTrainingParticipant[]
  offboardingClearances HrOffboardingClearance[]

