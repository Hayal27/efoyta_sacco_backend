// ─── Module: Core Banking Cash, Vault & Till Management ──────────────────────

enum TillSessionStatus {
  open
  closing_pending_vault
  closed
}

enum CashTransferType {
  vault_to_till
  till_to_vault
  vault_to_bank
  bank_to_vault
}

enum CashTransferStatus {
  pending
  approved
  completed
  rejected
  cancelled
}

enum VarianceType {
  shortage
  overage
  exact
}

enum VarianceStatus {
  pending
  resolved
}

model Vault {
  id             String            @id @default(uuid()) @db.Char(36)
  branchId       String            @db.Char(36)
  name           String            @db.VarChar(100)
  code           String            @unique @db.VarChar(50)
  glAccountId    String?           @db.Char(36)
  balance        Decimal           @default(0) @db.Decimal(18, 2)
  maxLimit       Decimal           @default(1000000) @db.Decimal(18, 2)
  status         String            @default("open") @db.VarChar(30) // open, closed, locked
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @db.DateTime(3)

  branch         Branch            @relation(fields: [branchId], references: [id])
  glAccount      GLAccount?        @relation(fields: [glAccountId], references: [id])
  tills          Till[]
  transfersFrom  CashTransfer[]    @relation("TransferFromVault")
  transfersTo    CashTransfer[]    @relation("TransferToVault")
  checks         VaultDailyCheck[]

  @@map("vaults")
}

model Till {
  id             String         @id @default(uuid()) @db.Char(36)
  name           String         @db.VarChar(100)
  code           String         @unique @db.VarChar(50)
  userId         String         @db.Char(36) // Assigned teller
  vaultId        String         @db.Char(36)
  branchId       String         @db.Char(36)
  glAccountId    String?        @db.Char(36)
  balance        Decimal        @default(0) @db.Decimal(18, 2)
  maxLimit       Decimal        @default(100000) @db.Decimal(18, 2)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @db.DateTime(3)

  user           User           @relation(fields: [userId], references: [id])
  vault          Vault          @relation(fields: [vaultId], references: [id])
  branch         Branch         @relation(fields: [branchId], references: [id])
  glAccount      GLAccount?     @relation(fields: [glAccountId], references: [id])
  sessions       TillSession[]
  transfersFrom  CashTransfer[] @relation("TransferFromTill")
  transfersTo    CashTransfer[] @relation("TransferToTill")

  @@unique([userId, branchId])
  @@map("tills")
}

model TillSession {
  id              String              @id @default(uuid()) @db.Char(36)
  sessionNumber   String              @unique @db.VarChar(50)
  tillId          String              @db.Char(36)
  userId          String              @db.Char(36)
  branchId        String              @db.Char(36)
  openedAt        DateTime            @default(now()) @db.DateTime(3)
  closedAt        DateTime?           @db.DateTime(3)
  openingBalance  Decimal             @default(0) @db.Decimal(18, 2)
  expectedClose   Decimal             @default(0) @db.Decimal(18, 2)
  countedClose    Decimal?            @db.Decimal(18, 2)
  variance        Decimal?            @db.Decimal(18, 2)
  status          TillSessionStatus   @default(open)
  notes           String?             @db.Text
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  updatedAt       DateTime            @updatedAt @db.DateTime(3)

  till            Till                @relation(fields: [tillId], references: [id])
  user            User                @relation(fields: [userId], references: [id])
  branch          Branch              @relation(fields: [branchId], references: [id])
  denominations   DenominationCount[]
  variances       CashVariance[]

  @@index([tillId, status])
  @@index([userId, status])
  @@map("till_sessions")
}

model CashTransfer {
  id              String              @id @default(uuid()) @db.Char(36)
  transferNumber  String              @unique @db.VarChar(50)
  type            CashTransferType
  fromVaultId     String?             @db.Char(36)
  toVaultId       String?             @db.Char(36)
  fromTillId      String?             @db.Char(36)
  toTillId        String?             @db.Char(36)
  fromAccountId   String?             @db.Char(36)
  toAccountId     String?             @db.Char(36)
  amount          Decimal             @db.Decimal(18, 2)
  status          CashTransferStatus  @default(pending)
  requestedById   String              @db.Char(36)
  approvedById    String?             @db.Char(36)
  receivedById    String?             @db.Char(36)
  rejectionReason String?             @db.VarChar(255)
  notes           String?             @db.Text
  bankSlipRef     String?             @db.VarChar(100)
  journalEntryId  String?             @db.Char(36)
  branchId        String              @db.Char(36)
  createdAt       DateTime            @default(now()) @db.DateTime(3)
  approvedAt      DateTime?           @db.DateTime(3)
  confirmedAt     DateTime?           @db.DateTime(3)

  fromVault       Vault?              @relation("TransferFromVault", fields: [fromVaultId], references: [id])
  toVault         Vault?              @relation("TransferToVault", fields: [toVaultId], references: [id])
  fromTill        Till?               @relation("TransferFromTill", fields: [fromTillId], references: [id])
  toTill          Till?               @relation("TransferToTill", fields: [toTillId], references: [id])
  requestedBy     User                @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy      User?               @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  receivedBy      User?               @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  branch          Branch              @relation(fields: [branchId], references: [id])
  denominations   DenominationCount[]

  @@index([type, status])
  @@index([branchId])
  @@map("cash_transfers")
}

model DenominationCount {
  id              String            @id @default(uuid()) @db.Char(36)
  referenceType   String            @db.VarChar(50) // till_open, till_close, vault_check, transfer
  referenceId     String            @db.Char(36)
  tillSessionId   String?           @db.Char(36)
  cashTransferId  String?           @db.Char(36)
  vaultCheckId    String?           @db.Char(36)
  denomination    Decimal           @db.Decimal(10, 2)
  quantity        Int
  totalAmount     Decimal           @db.Decimal(18, 2)
  createdAt       DateTime          @default(now()) @db.DateTime(3)

  tillSession     TillSession?      @relation(fields: [tillSessionId], references: [id], onDelete: Cascade)
  cashTransfer    CashTransfer?     @relation(fields: [cashTransferId], references: [id], onDelete: Cascade)
  vaultCheck      VaultDailyCheck?  @relation(fields: [vaultCheckId], references: [id], onDelete: Cascade)

  @@index([referenceType, referenceId])
  @@map("denomination_counts")
}

model CashVariance {
  id              String            @id @default(uuid()) @db.Char(36)
  sessionId       String?           @db.Char(36)
  vaultCheckId    String?           @db.Char(36)
  amount          Decimal           @db.Decimal(18, 2) // positive for overage, negative for shortage
  type            VarianceType
  reason          String?           @db.Text
  status          VarianceStatus    @default(pending)
  resolvedById    String?           @db.Char(36)
  resolutionNotes String?           @db.Text
  journalEntryId  String?           @db.Char(36)
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  resolvedAt      DateTime?         @db.DateTime(3)

  session         TillSession?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  vaultCheck      VaultDailyCheck?  @relation(fields: [vaultCheckId], references: [id], onDelete: Cascade)
  resolvedBy      User?             @relation(fields: [resolvedById], references: [id])

  @@index([status])
  @@map("cash_variances")
}

model VaultDailyCheck {
  id              String              @id @default(uuid()) @db.Char(36)
  vaultId         String              @db.Char(36)
  branchId        String              @db.Char(36)
  checkDate       DateTime            @db.Date
  checkType       String              @db.VarChar(20) // opening, closing, audit
  systemBalance   Decimal             @db.Decimal(18, 2)
  countedBalance  Decimal             @db.Decimal(18, 2)
  variance        Decimal             @default(0) @db.Decimal(18, 2)
  performedById   String              @db.Char(36)
  status          String              @default("confirmed") @db.VarChar(30) // confirmed, discrepancy_flagged
  notes           String?             @db.Text
  createdAt       DateTime            @default(now()) @db.DateTime(3)

  vault           Vault               @relation(fields: [vaultId], references: [id])
  branch          Branch              @relation(fields: [branchId], references: [id])
  performedBy     User                @relation(fields: [performedById], references: [id])
  denominations   DenominationCount[]
  variances       CashVariance[]

  @@index([vaultId, checkDate])
  @@map("vault_daily_checks")
}

