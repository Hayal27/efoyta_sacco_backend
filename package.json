{
    "name":  "efoyta-sacco-backend",
    "version":  "1.0.0",
    "private":  true,
    "description":  "EFOYTA Savings \u0026 Credit Cooperative Management System — Core Banking Express REST API",
    "main":  "dist/server.js",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "node build.js",
                    "build:tsc":  "tsc",
                    "start":  "node dist/server.js",
                    "test":  "jest --passWithNoTests",
                    "test:watch":  "jest --watch",
                    "test:coverage":  "jest --coverage",
                    "lint":  "eslint src --ext .ts",
                    "db:migrate":  "prisma migrate dev",
                    "db:push":  "prisma db push",
                    "db:migrate-oidc":  "tsx scripts/migrate-oidc-columns.ts",
                    "db:migrate-menus":  "tsx scripts/migrate-all-menus-to-db.ts",
                    "db:seed":  "tsx prisma/seed.ts",
                    "seed:report-menus":  "tsx prisma/add-report-menus.ts",
                    "seed:savings-menus":  "tsx prisma/add-savings-engine-menus.ts",
                    "seed:accounting-menus":  "tsx prisma/add-accounting-menus.ts",
                    "seed:hr-menus":  "tsx prisma/add-hr-menus.ts",
                    "db:studio":  "prisma studio",
                    "db:generate":  "prisma generate"
                },
    "dependencies":  {
                         "@coop/events":  "*",
                         "@coop/types":  "*",
                         "@coop/utils":  "*",
                         "@coop/validation":  "*",
                         "@prisma/client":  "^5.14.0",
                         "africastalking":  "^0.6.4",
                         "bcryptjs":  "^2.4.3",
                         "bullmq":  "^5.7.0",
                         "compression":  "^1.7.4",
                         "cookie-parser":  "^1.4.6",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "exceljs":  "^4.4.0",
                         "express":  "^4.19.2",
                         "express-async-errors":  "^3.1.1",
                         "express-rate-limit":  "^7.3.1",
                         "helmet":  "^7.1.0",
                         "ioredis":  "^5.4.1",
                         "ip-address":  "^9.0.5",
                         "jsonwebtoken":  "^9.0.2",
                         "jsqr":  "^1.4.0",
                         "morgan":  "^1.10.0",
                         "nodemailer":  "^6.9.13",
                         "puppeteer":  "^22.10.0",
                         "sharp":  "^0.35.5",
                         "socket.io":  "^4.8.3",
                         "tesseract.js":  "^7.0.0",
                         "uuid":  "^10.0.0",
                         "zod":  "^3.23.0"
                     },
    "devDependencies":  {
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/compression":  "^1.7.5",
                            "@types/cookie-parser":  "^1.4.7",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/jest":  "^29.5.12",
                            "@types/jsonwebtoken":  "^9.0.6",
                            "@types/morgan":  "^1.9.9",
                            "@types/nodemailer":  "^6.4.15",
                            "@types/supertest":  "^6.0.2",
                            "@types/uuid":  "^10.0.0",
                            "jest":  "^29.7.0",
                            "prisma":  "^5.14.0",
                            "supertest":  "^7.0.0",
                            "ts-jest":  "^29.1.4",
                            "tsx":  "^4.11.0",
                            "typescript":  "^5.4.5",
                            "esbuild":  "^0.21.5"
                        },
    "jest":  {
                 "preset":  "ts-jest",
                 "testEnvironment":  "node",
                 "testMatch":  [
                                   "**/*.test.ts"
                               ],
                 "coverageDirectory":  "coverage",
                 "collectCoverageFrom":  [
                                             "src/**/*.ts",
                                             "!src/server.ts"
                                         ]
             },
    "workspaces":  [
                       "packages/*"
                   ]
}
